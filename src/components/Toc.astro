---
import type { MarkdownHeading } from 'astro';
import TocList from './TocList.astro';
import type { TocNode } from './TocList.astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;

/** Nest a flat heading list so the contents list mirrors the article. */
function nest(items: MarkdownHeading[]): TocNode[] {
  const roots: TocNode[] = [];
  const stack: (TocNode & { depth: number })[] = [];
  for (const heading of items) {
    const node = { ...heading, children: [] };
    while (stack.length && stack.at(-1)!.depth >= node.depth) stack.pop();
    (stack.at(-1)?.children ?? roots).push(node);
    stack.push(node);
  }
  return roots;
}

const tree = nest(headings);
---

{
  tree.length > 0 && (
    <nav class="toc" aria-labelledby="toc-heading">
      <details class="disclosure">
        <summary>
          <span id="toc-heading">Contents</span>
        </summary>
        <TocList items={tree} />
      </details>
    </nav>
  )
}
